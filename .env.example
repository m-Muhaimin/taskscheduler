# ------------------------------------------------------------------
# tradescheduler environment template
# Copy to .env and fill in real values. Never commit .env.
#
# The API is designed to boot WITHOUT this file (no env at boot):
# external clients are constructed lazily, only when first used.
# ------------------------------------------------------------------

# Twilio (SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# WhatsApp fallback engine (T18): SMS-first delivery with a one-shot WhatsApp
# retry when an SMS delivery report comes back failed/undelivered.
# Public base URL for the API — used to derive the Twilio StatusCallback URL
# (<API_BASE_URL>/api/twilio/webhooks/status). Override it directly with
# TWILIO_MESSAGE_STATUS_CALLBACK_URL when the API sits behind a proxy/rewrite.
API_BASE_URL=
TWILIO_MESSAGE_STATUS_CALLBACK_URL=
# WhatsApp Business sender number (the org's WhatsApp number, E.164).
TWILIO_WHATSAPP_NUMBER=
# Countries eligible for SMS -> WhatsApp fallback (ITU codes with '+',
# comma-separated). Defaults to +880 (Bangladesh) when unset.
WHATSAPP_FALLBACK_COUNTRIES=+880
# Twilio Content API template SIDs for the fallback retry. The failed SMS body
# is sent as template variable {1}. WHATSAPP_TEMPLATE_GENERIC is the catch-all;
# a kind-specific SID (WHATSAPP_TEMPLATE_<KIND_UPPER_SNAKE>) wins when set.
# Kinds: BOOKING_CONFIRMATION, RESCHEDULE_OFFER, SLOT_INVALID, NO_AVAILABILITY,
# NO_MATCHING_BOOKING, VERIFICATION_CODE, CONFIRM_CODE, NUMBER_VERIFIED,
# CODE_MISMATCH, CONFIRM_FAILED, HELP, MISSED_CALL_CALLBACK, STAFF_ACK.
WHATSAPP_TEMPLATE_GENERIC=
WHATSAPP_TEMPLATE_BOOKING_CONFIRMATION=
WHATSAPP_TEMPLATE_RESCHEDULE_OFFER=
WHATSAPP_TEMPLATE_SLOT_INVALID=
WHATSAPP_TEMPLATE_NO_AVAILABILITY=
WHATSAPP_TEMPLATE_NO_MATCHING_BOOKING=
WHATSAPP_TEMPLATE_VERIFICATION_CODE=
WHATSAPP_TEMPLATE_CONFIRM_CODE=
WHATSAPP_TEMPLATE_NUMBER_VERIFIED=
WHATSAPP_TEMPLATE_CODE_MISMATCH=
WHATSAPP_TEMPLATE_CONFIRM_FAILED=
WHATSAPP_TEMPLATE_HELP=
WHATSAPP_TEMPLATE_MISSED_CALL_CALLBACK=
WHATSAPP_TEMPLATE_STAFF_ACK=

# Auth (dashboard JWT)
JWT_SECRET=

# Supabase (client + service-role access)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres direct connection (job queue worker in Step 4)
DATABASE_URL=

# Google OAuth (Calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Paddle (payment processor — chosen per CLAUDE.md; deposit/webhook not yet built)
# Generate API key at Paddle > Developer tools > Authentication.
# Sandbox keys contain _sdbx; live keys do not.
PADDLE_API_KEY=
# Webhook secret from Paddle vendor dashboard > Notifications when you create
# the endpoint. Used to verify inbound webhook signatures (fail-closed).
PADDLE_WEBHOOK_SECRET=
# sandbox | production — controls which Paddle API base URL the SDK hits.
PADDLE_ENV=sandbox

# API port. The API reads process.env.PORT; default 3001.
# API_PORT=3001

# AI (provider-agnostic LLM layer — packages/ai)
# AI_PROVIDER: openai | ollama | census | fallback-only (default fallback-only)
AI_PROVIDER=fallback-only
# Required when AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Ollama: key optional for local/unauthenticated instances
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma4:cloud
OLLAMA_BASE_URL=https://ollama.com
# Required when AI_PROVIDER=census
CENSUS_API_KEY=
CENSUS_MODEL=census/llama-4-scout
CENSUS_BASE_URL=https://api.census.ai/v1

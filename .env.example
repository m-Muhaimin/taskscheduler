# ------------------------------------------------------------------
# tradescheduler environment template
# Copy to .env and fill in real values. Never commit .env.
#
# The API is designed to boot WITHOUT this file (no env at boot):
# external clients are constructed lazily, only when first used.
# ------------------------------------------------------------------

# Twilio (SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Auth (dashboard JWT)
JWT_SECRET=

# Supabase (client + service-role access)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres direct connection (job queue worker in Step 4)
DATABASE_URL=

# Google OAuth (Calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Paddle (payment processor — chosen per CLAUDE.md; deposit/webhook not yet built)
# Generate API key at Paddle > Developer tools > Authentication.
# Sandbox keys contain _sdbx; live keys do not.
PADDLE_API_KEY=
# Webhook secret from Paddle vendor dashboard > Notifications when you create
# the endpoint. Used to verify inbound webhook signatures (fail-closed).
PADDLE_WEBHOOK_SECRET=
# sandbox | production — controls which Paddle API base URL the SDK hits.
PADDLE_ENV=sandbox

# API port. The API reads process.env.PORT; default 3001.
# API_PORT=3001

# AI (provider-agnostic LLM layer — packages/ai)
# AI_PROVIDER: openai | ollama | census | fallback-only (default fallback-only)
AI_PROVIDER=fallback-only
# Required when AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Ollama: key optional for local/unauthenticated instances
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma4
OLLAMA_BASE_URL=https://ollama.com
# Required when AI_PROVIDER=census
CENSUS_API_KEY=
CENSUS_MODEL=census/llama-4-scout
CENSUS_BASE_URL=https://api.census.ai/v1

{
  "name": "@tradescheduler/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "worker": "tsx src/worker/index.ts",
    "db:local": "node scripts/local-db.mjs",
    "db:local:reset": "node scripts/local-db.mjs --reset",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node scripts/db-migrate.mjs",
    "worker:start": "node dist/worker/index.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0",
    "@tradescheduler/ai": "0.1.0",
    "@tradescheduler/shared": "0.1.0",
    "express": "5.2.1",
    "googleapis": "148.0.0",
    "jsonwebtoken": "9.0.3",
    "pg": "8.23.0",
    "twilio": "6.1.1",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@types/express": "5.0.0",
    "@types/jsonwebtoken": "9.0.9",
    "@types/node": "22.20.3",
    "@types/pg": "8.11.10",
    "embedded-postgres": "^18.4.0-beta.17",
    "nodemon": "3.1.10",
    "tsx": "^4.19.4",
    "typescript": "5.9.3",
    "vitest": "^3.2.3"
  }
}
